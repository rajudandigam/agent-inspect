{
  "name": "@agent-inspect/mcp-server",
  "version": "6.17.3",
  "license": "MIT",
  "type": "module",
  "description": "Read-only MCP server for local AgentInspect TraceFacts, causal failure, and Evidence tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajudandigam/agent-inspect.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/rajudandigam/agent-inspect/issues"
  },
  "homepage": "https://github.com/rajudandigam/agent-inspect/tree/main/packages/mcp-server",
  "sideEffects": false,
  "bin": {
    "agent-inspect-mcp-server": "./bin/agent-inspect-mcp-server.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "pnpm --workspace-root exec tsup --config tsup.mcp-server.config.ts",
    "test": "vitest run -c ../../vitest.config.ts"
  },
  "dependencies": {
    "@agent-inspect/redact": "workspace:*",
    "agent-inspect": "workspace:*"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "agent-inspect",
    "tracefacts",
    "coding-agent",
    "local-first",
    "typescript"
  ]
}
