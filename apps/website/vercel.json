{
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/contracts",
      "destination": "/docs/trace-contracts",
      "permanent": true
    },
    {
      "source": "/docs/contracts/",
      "destination": "/docs/trace-contracts/",
      "permanent": true
    },
    {
      "source": "/docs/index.txt",
      "destination": "/docs/",
      "permanent": false
    },
    {
      "source": "/docs/:path*/index.txt",
      "destination": "/docs/:path*/",
      "permanent": false
    },
    {
      "source": "/index.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*/index.txt",
      "destination": "/:path*/",
      "permanent": false
    }
  ]
}
