{
  "name": "@agent-inspect/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-website-public-docs.mjs && node ../../scripts/copy-showcase-to-website.mjs && next dev",
    "build": "node ../../scripts/sync-website-public-docs.mjs && node ../../scripts/copy-showcase-to-website.mjs && next build && node ../../scripts/strip-website-flight-txt.mjs",
    "typecheck": "tsc --noEmit",
    "crawl": "node ../../scripts/crawl-website-export.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run crawl"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
